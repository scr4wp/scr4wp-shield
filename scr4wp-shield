tor_health()
{
    local ok=1

    echo "TOR HEALTH:"

    echo -n "SOCKS 9050: "
    if ss -lnt | grep -q ":9050"; then
        echo "PASS"
    else
        echo "FAIL"
        VERIFY_OK=0
        ok=0
    fi

    echo -n "DNS 5353: "
    if ss -lun | grep -q ":5353"; then
        echo "PASS"
    else
        echo "FAIL"
        VERIFY_OK=0
        ok=0
    fi

    echo -n "TRANS 9040: "
    if ss -lnt | grep -q ":9040"; then
        echo "PASS"
    else
        echo "FAIL"
        VERIFY_OK=0
        ok=0
    fi

    echo -n "CONTROL 9051: "
    if ss -lnt | grep -q ":9051"; then
        echo "PASS"
    else
        echo "FAIL"
        VERIFY_OK=0
        ok=0
    fi

    if [ "$ok" -eq 1 ]; then
        return 0
    else
        return 1
    fi
}


