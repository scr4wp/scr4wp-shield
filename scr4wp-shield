#!/usr/bin/env bash

set -Eeuo pipefail

BASE="/var/lib/scr4wp-shield"
STATE="$BASE/state"
VERIFY_STATE="$BASE/verify-state"
LOG="/var/log/scr4wp-shield/shield.log"
NFT="scr4wp_shield"

TOR="tor@default"


mkdir -p "$BASE"




get_state()
{
    if [ -f "$STATE" ]; then
        cat "$STATE"
    else
        echo UNKNOWN
    fi
}

mode_guard()
{
    local target="$1"
    local current

    current=$(get_state)

    if [ "$current" = "$target" ]; then
        log "Already in $target mode"
        echo "$target"
        return 1
    fi

    return 0
}


set_state()
{
    local value="$1"
    local tmp="${STATE}.tmp"

    echo "$value" > "$tmp"
    mv -f "$tmp" "$STATE"
}


dns_lock()
{
    log "DNS LOCK"

    IFACE=$(ip route | awk '/default/ {print $5; exit}')

    resolvectl dns "$IFACE" 127.0.0.1
    resolvectl domain "$IFACE" "~."
}

dns_unlock()
{
    log "DNS UNLOCK"

    IFACE=$(ip route | awk '/default/ {print $5; exit}')

    resolvectl revert "$IFACE"

    # restore normal DNS routing
    resolvectl dns "$IFACE" 1.1.1.1 8.8.8.8
    resolvectl domain "$IFACE" ""

    # force resolved to refresh link
    systemctl restart systemd-resolved

    # restore default route flag
    resolvectl default-route "$IFACE" yes
}



detect_optional_modules()
{
    MODULE_DIR="$BASE/modules"
    mkdir -p "$MODULE_DIR"

    ZAPRET_FOUND=0

    if systemctl list-unit-files 2>/dev/null | grep -q "^zapret.service"; then
        ZAPRET_FOUND=1
    fi

    if [ -d "/opt/zapret" ]; then
        ZAPRET_FOUND=1
    fi

    if pgrep -f nfqws >/dev/null 2>&1; then
        ZAPRET_FOUND=1
    fi

    if [ "$ZAPRET_FOUND" -eq 1 ]; then
        touch "$MODULE_DIR/zapret.detected"
    else
        rm -f "$MODULE_DIR/zapret.detected"
    fi
}



load_config()
{
    CONFIG_FILE="/etc/scr4wp-shield/config"

    TOR_SERVICE="tor@default"
    TOR_SOCKS_PORT="9050"
    DNS_PORT="5353"
    ZAPRET_SERVICE="zapret"
    FAIL_POLICY="BLOCK"

    if [ -f "$CONFIG_FILE" ]; then
        while IFS='=' read -r key value
        do
            case "$key" in
                TOR_SERVICE)
                    TOR_SERVICE="$value"
                    ;;
                TOR_SOCKS_PORT)
                    TOR_SOCKS_PORT="$value"
                    ;;
                DNS_PORT)
                    DNS_PORT="$value"
                    ;;
                ZAPRET_SERVICE)
                    ZAPRET_SERVICE="$value"
                    ;;
                FAIL_POLICY)
                    FAIL_POLICY="$value"
                    ;;
            esac
        done < "$CONFIG_FILE"
    fi
}


AUDIT="/var/log/scr4wp-shield/audit.log"

audit_log()
{
    mkdir -p "$(dirname "$AUDIT")"

    echo "$(date '+%F %T') $*" >> "$AUDIT"

    if [ -f "$AUDIT" ]; then
        lines=$(wc -l < "$AUDIT")

        if [ "$lines" -gt 500 ]; then
            tail -500 "$AUDIT" > "$AUDIT.tmp"
            mv "$AUDIT.tmp" "$AUDIT"
        fi
    fi
}


backups()
{
    echo "=============================="
    echo " SCR4WP BACKUPS"
    echo "=============================="
    echo

    if ls -1dt "$BASE"/backups/* >/dev/null 2>&1; then
        ls -1dt "$BASE"/backups/* | while read b
        do
            echo "$(basename "$b")"
        done
    else
        echo "NO BACKUPS"
    fi
}



backup_clean()
{
    echo "=============================="
    echo " SCR4WP BACKUP CLEAN"
    echo "=============================="
    echo

    KEEP=5

    count=$(ls -1dt "$BASE"/backups/* 2>/dev/null | wc -l)

    if [ "$count" -le "$KEEP" ]; then
        echo "Nothing to clean"
        echo "Backups: $count"
        return
    fi

    ls -1dt "$BASE"/backups/* | tail -n +$((KEEP+1)) | while read b
    do
        echo "Removing: $(basename "$b")"
        rm -rf "$b"
    done

    echo
    echo "Remaining:"
    ls -1dt "$BASE"/backups/* | wc -l
}

audit()
{
    echo "=============================="
    echo " SCR4WP AUDIT LOG"
    echo "=============================="
    echo

    if [ -f "$AUDIT" ]; then
        cat "$AUDIT"
    else
        echo "NO EVENTS"
    fi
}


log()
{
    echo "$(date '+%F %T') $*" | tee -a "$LOG"
}

load_config


backup()
{
    local d="$BASE/backups/$(date +%Y%m%d-%H%M%S)"

    echo "=============================="
    echo " SCR4WP SHIELD BACKUP"
    echo "=============================="
    echo

    echo "Creating:"
    echo " $d"
    echo

    mkdir -p "$d"

    echo "STATE:"
    if cp -a "$STATE" "$d/" 2>/dev/null; then
        echo "OK"
    else
        echo "SKIP"
    fi

    echo
    echo "TOR CONFIG:"
    if cp -a /etc/tor/torrc "$d/" 2>/dev/null; then
        echo "OK"
    else
        echo "SKIP"
    fi

    echo
    echo "NFT RULES:"
    if nft list ruleset > "$d/nft.rules" 2>/dev/null; then
        echo "OK"
    else
        echo "SKIP"
    fi

    echo
    echo "BACKUP COMPLETE"
    echo
}



fail_close()
{
    log "FAIL CLOSED ACTIVE"

    firewall_on

    set_state "FAIL"
}

load_config

firewall_on()
{
    nft delete table inet "$NFT" 2>/dev/null || true

    nft -f - <<EOFNFT
table inet $NFT {

chain prerouting {
    type nat hook prerouting priority dstnat - 10;
    policy accept;

    iifname "lo" accept

    ip daddr 127.0.0.0/8 accept

    tcp dport {80,443} redirect to :9040
}

chain output {
    type filter hook output priority -10;
    policy drop;

    oifname "lo" accept

    ip daddr 127.0.0.0/8 accept
    ip6 daddr ::1 accept

    meta skuid 127 accept

    tcp dport $TOR_SOCKS_PORT accept
    tcp dport 9051 accept
    tcp dport 9040 accept
    udp dport $DNS_PORT accept
}

chain nat_output {
    type nat hook output priority -100;
    policy accept;

    meta skuid 127 accept

    udp dport 53 redirect to :5353

    tcp dport {80,443} redirect to :9040
}

}
EOFNFT
}


firewall_off()
{
    nft delete table inet "$NFT" 2>/dev/null || true
}


tor_wait()
{
    log "Waiting Tor SOCKS"

    for i in $(seq 1 120)
    do
        if ss -lnt | grep -q ':9050'
        then
            return 0
        fi

        sleep 1
    done

    return 1
}


tor_verify()
{
    log "Checking Tor exit"

    local r

    r=$(curl \
        --fail \
        --silent \
        --show-error \
        --socks5-hostname 127.0.0.1:9050 \
        --connect-timeout 10 \
        --max-time 30 \
        https://check.torproject.org 2>/dev/null || true)

    echo "$r" | grep -q "configured to use Tor"
}



dns_verify()
{
    log "Checking DNS routing"

    local r

    r=$(dig \
        @127.0.0.1 \
        -p "$DNS_PORT" \
        example.com \
        +short \
        2>/dev/null || true)

    if [ -n "$r" ]
    then
        return 0
    fi

    return 1
}


ipv6_verify()
{
    if curl -6 \
    --connect-timeout 3 \
    --max-time 5 \
    -s https://icanhazip.com >/dev/null
    then
        return 1
    fi

    return 0
}


normal()
{
    mode_guard NORMAL || return 0

    log "NORMAL MODE"
    audit_log "MODE NORMAL"

    backup

    # remove OPSEC routing first
    firewall_off

    # restore normal DNS
    dns_unlock

    # stop tor
    systemctl stop "$TOR_SERVICE" || true
    systemctl disable "$TOR_SERVICE" >/dev/null 2>&1 || true

   # restore optional network module
   if [ -f "$BASE/modules/zapret.detected" ]; then
       systemctl enable "$ZAPRET_SERVICE" >/dev/null 2>&1 || true
       systemctl restart "$ZAPRET_SERVICE" || true
   fi

    # verify normal routing
    sleep 1

    if nft list table inet "$NFT" >/dev/null 2>&1; then
        log "NORMAL NFT STILL ACTIVE"
        set_state "FAIL"
        exit 1
    fi

    if ss -lnt | grep -q ":9050"; then
        log "NORMAL TOR STILL ACTIVE"
        set_state "FAIL"
        exit 1
    fi

    set_state "NORMAL"

    log "NORMAL READY"
    audit_log "NORMAL READY"
}


opsec()
{
    mode_guard OPSEC || return 0

    log "OPSEC START"
    audit_log "MODE OPSEC START"

    backup


    # stop optional network module
   if [ -f "$BASE/modules/zapret.detected" ]; then
       systemctl stop "$ZAPRET_SERVICE" || true
   fi

    firewall_on


    systemctl start "$TOR_SERVICE"


    if ! tor_wait
    then
        log "TOR SOCKS FAILED"
        set_state "FAIL"
        exit 1
    fi


    if ! tor_verify
    then
        log "TOR VERIFY FAILED"
        set_state "FAIL"
        exit 1
    fi


    dns_lock


    if ! dns_verify
    then
        log "DNS LEAK FAILED"
        set_state "FAIL"
        exit 1
    fi


    if ! ipv6_verify
    then
        log "IPV6 LEAK FAILED"
        set_state "FAIL"
        exit 1
    fi


    set_state "OPSEC"

    log "OPSEC READY"
    audit_log "OPSEC READY"
}





killswitch_test()
{
    echo "=============================="
    echo " SCR4WP KILLSWITCH TEST"
    echo "=============================="
    echo

    echo "Stopping Tor temporarily..."
    systemctl stop "$TOR_SERVICE"

    sleep 3

    echo -n "Internet blocked: "

    if curl --connect-timeout 5 -s https://example.com >/dev/null; then
        echo "FAIL"
        VERIFY_OK=0
    else
        echo "PASS"
    fi

    systemctl start "$TOR_SERVICE"

    echo
    echo "Tor restored"
}

