watchdog()
{
    echo "=============================="
    echo " SCR4WP WATCHDOG"
    echo "=============================="
    echo

    local FAIL=0

    echo "TOR:"
    if ss -lnt | grep -q ":9050"; then
        echo "PASS"
    else
        echo "FAIL"
        FAIL=1
    fi

    echo
    echo "DNS:"
    if resolvectl status | grep -q "DNS Servers: 127.0.0.1"; then
        echo "PASS"
    else
        echo "FAIL"
        FAIL=1
    fi

    echo
    echo "NFT:"
    if nft list table inet "$NFT" >/dev/null 2>&1; then
        echo "PASS"
    else
        echo "FAIL"
        FAIL=1
    fi

    echo
    echo "STATE:"
    if [ -f "$STATE" ] && grep -q "OPSEC" "$STATE"; then
        echo "PASS"
    else
        echo "FAIL"
        FAIL=1
    fi

    echo

    if [ "$FAIL" -eq 1 ]; then
        echo "STATUS:"
        echo "FAULT DETECTED"

        audit_log "WATCHDOG FAULT"

        recover

        audit_log "WATCHDOG RECOVERY"
    else
        echo "STATUS:"
        echo "HEALTHY"

        audit_log "WATCHDOG HEALTHY"
    fi

}


snapshot()
{
    SNAP="$BASE/snapshot"

    echo "=============================="
    echo " SCR4WP SNAPSHOT"
    echo "=============================="

    {
        echo "TIME=$(date '+%F %T')"
        echo "MODE=$(cat "$STATE" 2>/dev/null)"
        echo "TOR=$(ss -lnt | grep -q ':9050' && echo PASS || echo FAIL)"
        echo "DNS=$(resolvectl dns | grep -q '127.0.0.1' && echo LOCKED || echo OPEN)"
        echo "NFT=$(nft list table inet "$NFT" >/dev/null 2>&1 && echo ACTIVE || echo OFF)"
        echo "KERNEL=$(uname -r)"
    } > "$SNAP"

    cat "$SNAP"
}


integrity()
{
    echo "=============================="
    echo " SCR4WP INTEGRITY ENGINE"
    echo "=============================="
    echo

    INT="$BASE/integrity"
    mkdir -p "$INT"

    echo "SCRIPT:"
    sha256sum /usr/local/sbin/scr4wp-shield > "$INT/script.new"

    if [ -f "$INT/script" ]; then
        if cmp -s "$INT/script.new" "$INT/script"; then
            echo "UNCHANGED"
        else
            echo "CHANGED"
            audit_log "INTEGRITY SCRIPT CHANGED"
        fi
    else
        echo "BASELINE CREATED"
    fi

    mv "$INT/script.new" "$INT/script"

    echo

    echo "STATE:"
    if [ -f "$STATE" ]; then
        sha256sum "$STATE" > "$INT/state"
        echo "OK"
    else
        echo "MISSING"
    fi

    echo

    echo "NFT:"

    MODE=$(cat "$STATE" 2>/dev/null)

    if [ "$MODE" = "NORMAL" ]; then
        if nft list table inet "$NFT" >/dev/null 2>&1; then
            echo "UNEXPECTED"
            audit_log "INTEGRITY NFT ACTIVE IN NORMAL"
        else
            echo "OFF (OK)"
        fi
    else
        if nft list table inet "$NFT" >/dev/null 2>&1; then
            echo "OK"
        else
            echo "MISSING"
            audit_log "INTEGRITY NFT FAILED"
        fi
    fi

    echo

    echo "RESULT:"
    echo "INTEGRITY READY"

    audit_log "INTEGRITY CHECK"
}



security_score()
{
    SCORE=0
    MODE=$(cat "$STATE" 2>/dev/null)

    echo "=============================="
    echo " SCR4WP SECURITY SCORE"
    echo "=============================="
    echo

    echo "MODE:"
    echo "$MODE"
    echo


    if [ "$MODE" = "NORMAL" ]; then

        echo "PROFILE: NORMAL"
        echo

        echo "TOR OFF:"
        if ! ss -lnt | grep -q ":9050"; then
            echo "PASS +20"
            SCORE=$((SCORE+20))
        else
            echo "FAIL"
        fi

        echo
        echo "DNS NORMAL:"
        if ! resolvectl status | grep -q "DNS Servers: 127.0.0.1"; then
            echo "PASS +20"
            SCORE=$((SCORE+20))
        else
            echo "FAIL"
        fi

        echo
        echo "NFT OFF:"
        if ! nft list table inet "$NFT" >/dev/null 2>&1; then
            echo "PASS +20"
            SCORE=$((SCORE+20))
        else
            echo "FAIL"
        fi

        echo
        echo "ZAPRET:"
        if systemctl is-active --quiet "$ZAPRET_SERVICE"; then
            echo "PASS +15"
            SCORE=$((SCORE+15))
        else
            echo "FAIL"
        fi


    else

        echo "PROFILE: OPSEC"
        echo

        echo "TOR:"
        if ss -lnt | grep -q ":9050"; then
            echo "PASS +20"
            SCORE=$((SCORE+20))
        else
            echo "FAIL"
        fi

        echo
        echo "DNS LOCK:"
        if resolvectl status | grep -q "DNS Servers: 127.0.0.1"; then
            echo "PASS +20"
            SCORE=$((SCORE+20))
        else
            echo "FAIL"
        fi

        echo
        echo "NFT FIREWALL:"
        if nft list table inet "$NFT" >/dev/null 2>&1; then
            echo "PASS +20"
            SCORE=$((SCORE+20))
        else
            echo "FAIL"
        fi

        echo
        echo "KILLSWITCH:"
        if nft list table inet "$NFT" >/dev/null 2>&1; then
            echo "PASS +15"
            SCORE=$((SCORE+15))
        else
            echo "FAIL"
        fi

    fi


    echo
    echo "WATCHDOG:"
    if systemctl is-enabled --quiet scr4wp-shield-watchdog.timer; then
        echo "PASS +10"
        SCORE=$((SCORE+10))
    else
        echo "FAIL"
    fi


    echo
    echo "INTEGRITY:"
    if [ -f "$BASE/integrity/script" ]; then
        echo "PASS +10"
        SCORE=$((SCORE+10))
    else
        echo "FAIL"
    fi


    echo
    echo "VERIFY:"
    if [ -f "$VERIFY_STATE" ] && grep -q "RESULT=PASS" "$VERIFY_STATE"; then
        echo "PASS +5"
        SCORE=$((SCORE+5))
    else
        echo "FAIL"
    fi


    echo
    echo "=============================="
    echo "SECURITY SCORE:"
    echo "$SCORE/100"
    echo "=============================="

    audit_log "SECURITY SCORE $SCORE/100"
}



report()
{
    if [ "${2:-}" = "--json" ] || [ "${1:-}" = "--json" ]; then

        MODE=$(cat "$STATE" 2>/dev/null || echo UNKNOWN)

        TOR=$(ss -lnt | grep -q ":9050" && echo PASS || echo FAIL)
        DNS=$(resolvectl dns | grep -q "127.0.0.1" && echo LOCKED || echo OPEN)
        NFT=$(nft list table inet "$NFT" >/dev/null 2>&1 && echo ACTIVE || echo OFF)
        WATCHDOG=$(systemctl is-enabled --quiet scr4wp-shield-watchdog.timer && echo ACTIVE || echo OFF)
        INT=$( [ -f "$BASE/integrity/script" ] && echo PASS || echo FAIL )

        cat <<EOF
{
  "mode":"$MODE",
  "tor":"$TOR",
  "dns":"$DNS",
  "firewall":"$NFT",
  "watchdog":"$WATCHDOG",
  "integrity":"$INT"
}
EOF

        return
    fi

    echo "=============================="
    echo " SCR4WP SECURITY REPORT"
    echo "=============================="
    echo

    echo "MODE:"
    cat "$STATE" 2>/dev/null || echo UNKNOWN

    echo

    MODE=$(cat "$STATE" 2>/dev/null)

    echo "TOR:"
    if [ "$MODE" = "NORMAL" ]; then
        ss -lnt | grep -q ":9050" && echo "FAIL" || echo "OFF (OK)"
    else
        ss -lnt | grep -q ":9050" && echo "PASS" || echo "FAIL"
    fi

    echo

    echo "DNS:"
    if [ "$MODE" = "NORMAL" ]; then
        resolvectl status | grep -q "DNS Servers: 127.0.0.1" && echo "FAIL" || echo "OPEN (OK)"
    else
        resolvectl status | grep -q "DNS Servers: 127.0.0.1" && echo "LOCKED" || echo "FAIL"
    fi

    echo

    echo "FIREWALL:"
    nft list table inet "$NFT" >/dev/null 2>&1 && echo "ACTIVE" || echo "OFF"

    echo

    echo "WATCHDOG:"
    systemctl is-enabled --quiet scr4wp-shield-watchdog.timer && echo "ACTIVE" || echo "OFF"

    echo

    echo "INTEGRITY:"
    [ -f "$BASE/integrity/script" ] && echo "PASS" || echo "FAIL"

    echo

    echo "VERIFY:"
    if [ -f "$VERIFY_STATE" ]; then
        grep RESULT "$VERIFY_STATE"
    else
        echo NONE
    fi

    echo

    echo "AUDIT:"
    [ -f "$AUDIT" ] && echo "HEALTHY" || echo "MISSING"

    audit_log "REPORT GENERATED"
}



