health_summary()
{
    local fail=0
    MODE=$(cat "$STATE" 2>/dev/null)

    echo "=============================="
    echo " SCR4WP HEALTH ENGINE"
    echo "=============================="
    echo

    echo "MODE:"
    echo "$MODE"

    echo

    if [ "$MODE" = "NORMAL" ]; then

        echo "PROFILE: NORMAL"

        echo
        echo "TOR:"
        if ! ss -lnt | grep -q ":9050"; then
            echo "STATE: OFF (OK)"
        else
            echo "STATE: FAILED"
            fail=1
        fi

        echo
        echo "DNS:"
        if ! resolvectl status | grep -q "DNS Servers: 127.0.0.1"; then
            echo "STATE: NORMAL"
        else
            echo "STATE: FAILED"
            fail=1
        fi

        echo
        echo "NFT:"
        if ! nft list table inet "$NFT" >/dev/null 2>&1; then
            echo "STATE: OFF (OK)"
        else
            echo "STATE: FAILED"
            fail=1
        fi

        echo
        echo "ZAPRET:"
        if systemctl is-active --quiet "$ZAPRET_SERVICE"; then
            echo "STATE: READY"
        else
            echo "STATE: FAILED"
            fail=1
        fi

    else

        echo "PROFILE: OPSEC"

        echo
        echo "TOR:"
        if tor_health; then
            echo "STATE: HEALTHY"
        else
            echo "STATE: FAILED"
            fail=1
        fi

        echo
        echo "DNS LOCK:"
        if resolvectl status | grep -q "DNS Servers: 127.0.0.1"; then
            echo "STATE: LOCKED"
        else
            echo "STATE: FAILED"
            fail=1
        fi

        echo
        echo "NFT:"
        if nft list table inet "$NFT" >/dev/null 2>&1; then
            echo "STATE: ACTIVE"
        else
            echo "STATE: FAILED"
            fail=1
        fi

    fi

    echo
    echo "CONFIG:"
    if [ -f /etc/scr4wp-shield/config ]; then
        echo "STATE: VALID"
    else
        echo "STATE: FAILED"
        fail=1
    fi

    echo

    if [ "$fail" -eq 0 ]; then
        echo "SECURITY STATE: GREEN"
        return 0
    else
        echo "SECURITY STATE: RED"
        return 1
    fi
}


status()
{
    echo "=============================="
    echo " SCR4WP SHIELD v3"
    echo "=============================="
    echo

    echo "MODE:"
    if [ -f "$STATE" ]; then
        cat "$STATE"
    else
        echo "UNKNOWN"
    fi

    echo

    echo "HEALTH:"
    if health_summary >/dev/null; then
        echo "GREEN"
    else
        echo "RED"
    fi

    echo

    echo "LAST BACKUP:"
    LAST_BACKUP=$(ls -1dt "$BASE"/backups/* 2>/dev/null | head -1 || true)

    if [ -n "$LAST_BACKUP" ]; then
        echo "OK"
        echo "$(basename "$LAST_BACKUP")"
    else
        echo "NONE"
    fi

    echo

    echo "SYSTEM:"
    echo "READY"

    echo

    echo "LAST VERIFY:"
    if [ -f "$VERIFY_STATE" ]; then
        cat "$VERIFY_STATE"
    else
        echo "NONE"
    fi

    echo

    echo "SECURITY SCORE:"
    security_score | awk '/SECURITY SCORE:/{getline;print}'

    echo

    MODE=$(cat "$STATE" 2>/dev/null)

    echo "TOR:"
    if [ "$MODE" = "NORMAL" ]; then
        ss -lnt | grep -q ":9050" && echo "FAIL" || echo "OFF (OK)"
    else
        ss -lnt | grep -q ":9050" && echo "PASS" || echo "FAIL"
    fi

    echo

    echo "DNS:"
    if [ "$MODE" = "NORMAL" ]; then
        resolvectl status | grep -q "DNS Servers: 127.0.0.1" && echo "FAIL" || echo "OPEN (OK)"
    else
        resolvectl status | grep -q "DNS Servers: 127.0.0.1" && echo "LOCKED" || echo "FAIL"
    fi

    echo

    echo "NFT:"
    nft list table inet "$NFT" >/dev/null 2>&1 && echo "ACTIVE" || echo "OFF"

    echo

    echo "WATCHDOG:"
    systemctl is-enabled --quiet scr4wp-shield-watchdog.timer && echo "ACTIVE" || echo "OFF"

    echo

    echo "INTEGRITY:"
    [ -f "$BASE/integrity/script" ] && echo "PASS" || echo "MISSING"
}


